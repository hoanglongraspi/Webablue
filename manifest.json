{
  "name": "WebAble Extension",
  "version": "1.4",
  "manifest_version": 3,
  "description": "Voice nav, video transcription, AI alt text, and simplified rewriting on right-click.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "contextMenus"          // Needed for the right-click context menu
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "voiceNav.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "contentScriptAltText.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "contentScriptReplaceHighlight.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
